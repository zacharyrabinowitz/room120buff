            position: absolute;
            width: 100%;
            top: 0;
            z-index: 10;
        }
        .global-header .mobile-subsection {
            background: #ff4c00;
            height: 48px;
        }

        .toast-logo {
            display: none;
        }

        /* Desktop skeleton */
        @media (min-width: 768px) {
            body {
                margin-top: 4rem;
            }

            .toast-logo {
                display: block;
                background: #ff4c00;
                width: 4rem;
                height: 4rem;
            }

            .toast-mobile-logo {
                display: hidden;
            }

            .global-header {
                background: white;
                border-bottom: 1px solid rgba(0, 0, 0, 0.12);
                height: 4rem;
                position: fixed;
                width: 100%;
                top: 0;
            }
            .global-header .mobile-subsection {
                display: none;
            }
        }
    </style>
</head>
