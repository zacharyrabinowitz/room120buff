# Toast API Configuration (READ-ONLY ACCESS)
# Never commit your actual .env file to GitHub
# Copy this file to .env and fill in your actual values

# Toast OAuth Credentials (from Toast support - read-only scope recommended)
TOAST_CLIENT_ID=your_client_id_here
TOAST_CLIENT_SECRET=your_client_secret_here
TOAST_API_SCOPE=restaurants.read orders.read checks.read

# Toast API Endpoints
TOAST_SANDBOX_URL=https://sandbox.toasttab.com
TOAST_PRODUCTION_URL=https://api.toasttab.com

# Environment: 'sandbox' or 'production'
TOAST_ENVIRONMENT=sandbox

# Your Restaurant ID from Toast
TOAST_RESTAURANT_ID=your_restaurant_id_here

# Logging
LOG_LEVEL=INFO

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your_super_secret_key_change_this_in_production

# Database
DATABASE_URL=sqlite:///room120.db
